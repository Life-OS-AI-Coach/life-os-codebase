# =============================================================================
# LifeOS AI — Phase 1 Local Development Environment
# Copy this file to `.env` (used by docker compose) before running.
#   cp .env.example .env
# =============================================================================

# ----- Core -----
NODE_ENV=development
TZ=UTC

# ----- PostgreSQL -----
POSTGRES_USER=lifeos
POSTGRES_PASSWORD=lifeos_dev_password
POSTGRES_DB=lifeos
POSTGRES_PORT=5432
# Connection string consumed by the API (Prisma). Host `postgres` = compose service name.
DATABASE_URL=postgresql://lifeos:lifeos_dev_password@postgres:5432/lifeos?schema=public

# ----- Redis -----
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ----- API (NestJS backend) -----
API_PORT=3001
API_GLOBAL_PREFIX=api
# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:3000
# JWT signing secret — CHANGE IN ANY SHARED ENVIRONMENT.
JWT_SECRET=change_me_super_secret_dev_only
JWT_EXPIRES_IN=1d
LOG_LEVEL=debug

# ----- AI Planner -----
# Provider: `deterministic` (no external calls, default) or `anthropic`.
AI_PROVIDER=deterministic
# Only used when AI_PROVIDER=anthropic. Leave blank to force the deterministic fallback.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
AI_MAX_RETRIES=2

# ----- Frontend (Next.js) -----
WEB_PORT=3000
# Base URL the BROWSER uses to reach the API (published host port).
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ----- MinIO (S3-compatible object storage) -----
MINIO_ROOT_USER=lifeos
MINIO_ROOT_PASSWORD=lifeos_dev_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ----- pgAdmin -----
PGADMIN_DEFAULT_EMAIL=admin@lifeos.local
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# ----- MailHog (email testing) -----
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
